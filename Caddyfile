# Nominatim/OSRM are NOT exposed publicly — the frontend reaches them through
# its own /api/geo/* proxy over the internal network. Only two public hosts:
{
	email kontakt@foerderverein-binnenmarsch.de
}

elb-fahrt.de {
	reverse_proxy frontend:3000
}

api.elb-fahrt.de {
	reverse_proxy strapi:1337
}

# Self-hosted error monitoring (Bugsink). Admin-only; keep it that way via
# SINGLE_USER + no public registration (see docker-compose.yml).
errors.elb-fahrt.de {
	reverse_proxy bugsink:8000
}
