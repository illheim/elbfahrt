# ============================================================
#  elb-fahrt.de — environment variables
#  Copy to .env and fill in. Never commit .env.
#  Generate each secret with: openssl rand -base64 32
# ============================================================

# Postgres
DB_PASSWORD=

# Strapi 5 secrets (each must be a strong random value)
STRAPI_APP_KEYS=          # comma-separated, 4 keys recommended
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=

# Next.js
NEXTAUTH_SECRET=

# CORS — comma-separated browser origins allowed to call the API.
# Optional; defaults to http://localhost:3000,https://elb-fahrt.de
# CORS_ORIGINS=https://elb-fahrt.de

# Public API URL — used to build the email-confirmation link.
# Dev leaves this empty (Strapi builds http://localhost:1337). Prod:
# PUBLIC_URL=https://api.elb-fahrt.de

# SMTP (production). In DEV these stay unset and Strapi sends to the Mailpit
# mail-catcher automatically (plugins.ts defaults + docker-compose.override.yml
# → read caught mail at http://localhost:8025). For prod, pick a provider
# (Mailgun / Postmark / Hetzner — PLAN M4) and fill these in .env, then
# uncomment the SMTP_* passthrough in docker-compose.yml's strapi service.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@elb-fahrt.de
# SMTP_REPLY_TO=no-reply@elb-fahrt.de
