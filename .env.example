# ============================================================
#  elb-fahrt.de — environment variables
#  Copy to .env and fill in. Never commit .env.
#  Generate each secret with: openssl rand -base64 32
# ============================================================

# Postgres
DB_PASSWORD=

# Strapi 5 secrets (each must be a strong random value)
STRAPI_APP_KEYS=          # comma-separated, 4 keys recommended
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=

# Next.js
NEXTAUTH_SECRET=

# CORS — comma-separated browser origins allowed to call the API.
# Optional; defaults to http://localhost:3000,https://elb-fahrt.de
# CORS_ORIGINS=https://elb-fahrt.de

# Public API URL — used to build the email-confirmation link.
# Dev leaves this empty (Strapi builds http://localhost:1337). Prod:
# PUBLIC_URL=https://api.elb-fahrt.de

# SMTP (production). In DEV these stay unset and Strapi sends to the Mailpit
# mail-catcher automatically (plugins.ts defaults + docker-compose.override.yml
# → read caught mail at http://localhost:8025). For prod, pick a provider
# (Mailgun / Postmark / Hetzner — PLAN M4) and fill these in .env, then
# uncomment the SMTP_* passthrough in docker-compose.yml's strapi service.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false        # true for port 465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@elb-fahrt.de
# SMTP_REPLY_TO=no-reply@elb-fahrt.de

# ------------------------------------------------------------
# Error monitoring — self-hosted Bugsink (Sentry-SDK compatible)
# ------------------------------------------------------------
# Bugsink server secrets (needed to bring the container up).
# SECRET_KEY: openssl rand -base64 50   ·   SUPERUSER: email:password
BUGSINK_SECRET_KEY=
BUGSINK_SUPERUSER=admin@foerderverein-binnenmarsch.de:change-me

# DSNs — leave EMPTY on first deploy. After Bugsink is up at
# https://errors.elb-fahrt.de, log in, create a "frontend" and a "backend"
# project, then paste each project's DSN here and redeploy (frontend must be
# rebuilt — the frontend DSN is baked into the browser bundle).
SENTRY_DSN_FRONTEND=
SENTRY_DSN_BACKEND=

# ------------------------------------------------------------
# Public-transit departures (v2.0 PROTOTYPE — off by default)
# ------------------------------------------------------------
# When true, ride detail shows next departures from the nearest stop. The proxy
# then calls MOTIS_URL server-side (coord + time only, no user PII). The default
# is the free community Transitous API — a THIRD PARTY; before showing this to
# real users, either self-host MOTIS (set MOTIS_URL to it) or disclose Transitous
# in the Datenschutz. No rebuild needed to toggle — it's a runtime env.
# TRANSIT_ENABLED=false
# MOTIS_URL=https://api.transitous.org
